# ============================================
# SeniorConnect Environment Configuration
# ============================================
# Copy this file to .env and fill in the values

# ---- Application ----
NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ---- Database ----
DATABASE_URL=postgresql://seniorconnect:seniorconnect@localhost:5432/seniorconnect?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT ----
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_SECRET
JWT_REFRESH_EXPIRATION=7d

# ---- OTP ----
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_LENGTH=6

# ---- Email (SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM="SeniorConnect <noreply@seniorconnect.com>"

# ---- File Storage (S3-compatible) ----
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=seniorconnect
STORAGE_REGION=us-east-1
STORAGE_SIGNED_URL_EXPIRY=3600

# ---- STUN/TURN (WebRTC) ----
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Rate Limiting ----
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000
